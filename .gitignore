# Dependencies. The game itself has none; playwright is a dev tool.
node_modules/

# Screenshots written by the browser tools (preview.js writes here by default,
# ui-smoke.js with --shots=.).
screenshots/
*.png
# ...except the app icons, which are generated once by tools/make-icons.js and
# have to ship: iOS and Android will not take the SVG.
!/apple-touch-icon.png
!/icon-192.png
!/icon-512.png

# A local copy of the system libraries Chromium needs, unpacked next to the
# project where they are not installed system-wide.
browser-libs/
.cache/

# Vercel CLI scratch.
.vercel/

# Lokale Claude-Code-Einstellungen (settings.local.json) — Berechtigungen sind
# pro Arbeitsplatz erteilt und gehen niemanden sonst etwas an.
.claude/

.DS_Store
